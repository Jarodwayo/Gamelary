# Copier en .env à la racine et remplir les clés voulues (voir le tableau
# README.md "Variables d'environnement" pour le détail des rôles). L'app
# démarre sans aucune clé — replis explicites (jeux de démonstration,
# jaquette placeholder, rangées Explorer vides, fonctionnalités Steam
# masquées) plutôt qu'un écran d'erreur — donc rien de bloquant à configurer
# pour un premier lancement, seulement pour débloquer les données réelles.

# IGDB (src/app/api/games+api.ts) : catalogue de jeux (titres, plateformes,
# Explorer). IGDB utilise l'authentification Twitch "Client Credentials" :
# 1. Crée une application sur https://dev.twitch.tv/console/apps -> Client ID
#    (= IGDB_CLIENT_ID) et Client Secret.
# 2. Échange Client ID/Secret contre un token OAuth via l'API Twitch
#    (voir https://dev.twitch.tv/docs/authentication/getting-tokens-oauth/#client-credentials-grant-flow)
#    -> IGDB_ACCESS_TOKEN. Expire au bout de ~60 jours côté Twitch, à
#    régénérer manuellement tant qu'aucun rafraîchissement automatique n'est
#    en place.
IGDB_CLIENT_ID=
IGDB_ACCESS_TOKEN=

# SteamGridDB (src/app/api/cover+api.ts) : jaquettes de jeux. Clé personnelle
# sans expiration, à générer sur
# https://www.steamgriddb.com/profile/preferences/api (compte SteamGridDB
# requis).
STEAMGRIDDB_API_KEY=

# URL du backend Steam séparé (succès + temps de jeu, voir gamelary-api :
# https://github.com/Jarodwayo/gamelary-api), une fois déployé. Comme la
# variable suivante, préfixée EXPO_PUBLIC_ (finit dans le bundle client,
# voir src/lib/steam-api-url.ts) — jamais un secret, juste une URL.
EXPO_PUBLIC_STEAM_API_URL=

# Adresse de contact de l'écran "Aide et idées" (facultative, voir
# src/lib/support-links.ts). Renseignée avec une adresse valide, la ligne
# "Contacter l'assistance" ouvre un e-mail. Laissée vide comme ici — ou
# remplie d'une valeur mal formée — elle ouvre une nouvelle issue sur le
# dépôt public : la ligne garde toujours une destination valide, et aucune
# adresse personnelle n'est codée en dur dans le dépôt.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Domaine public utilisé pour le lien de profil partageable
# (https://<domaine>/u/<identifiant>, voir src/lib/profile-link.ts).
# Facultative : sans elle, le lien retombe sur l'URL de l'app elle-même
# (origine web, ou lien profond gamelary:// sur mobile). La page publique
# correspondante suppose des comptes hébergés, encore au backlog (voir
# ARCHITECTURE.md §10).
EXPO_PUBLIC_PROFILE_BASE_URL=
